# SABnzbd Configuration
SABNZBD_URL=http://your-unraid-ip:8080
SABNZBD_API_KEY=your_sabnzbd_api_key

# Prowlarr Configuration
PROWLARR_URL=http://your-unraid-ip:9696
PROWLARR_API_KEY=your_prowlarr_api_key

# Plex Configuration
PLEX_URL=http://your-unraid-ip:32400
PLEX_TOKEN=your_plex_token

# F1 Plex Library (optional, usually auto-detected)
# F1_PLEX_LIBRARY=Formula 1
# F1_PLEX_LIBRARY_ID=

# Discord Webhooks (optional)
# DISCORD_F1_WEBHOOK=https://discord.com/api/webhooks/...

# F1 Plex Library ID (find via Plex API or leave as default)
F1_PLEX_LIBRARY_ID=2
