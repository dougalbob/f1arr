<?xml version="1.0"?>
<Container version="2">
  <Name>f1arr</Name>
  <Repository>ghcr.io/dougalbob/f1arr:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/dougalbob/f1arr/issues</Support>
  <Project>https://github.com/dougalbob/f1arr</Project>
  <Overview>F1arr - Automated Formula 1 session grabber and organizer for Plex.&#xD;
&#xD;
SETUP:&#xD;
1. Set your Media Library path (where your F1 folder is/will be)&#xD;
2. Set your Downloads path (where SABnzbd downloads to)&#xD;
3. Set the F1 Library Path to match (e.g., /media/Motorsport/F1)&#xD;
4. Enter your API keys for SABnzbd, Prowlarr, and Plex&#xD;
5. Click Apply&#xD;
&#xD;
WebUI available at http://[IP]:5678 after starting.</Overview>
  <Category>Downloaders: MediaApp:Other</Category>
  <WebUI>http://[IP]:[PORT:5678]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/dougalbob/f1arr/main/unraid-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/dougalbob/f1arr/main/assets/f1_icon.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="5678" Default="5678" Mode="tcp" Description="WebUI port - access at http://your-ip:5678" Type="Port" Display="always" Required="true" Mask="false">5678</Config>
  <Config Name="Media Library" Target="/media" Default="" Mode="rw" Description="Host path to your MEDIA root (e.g., /mnt/user/data/media or /mnt/user/Media)" Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Downloads" Target="/downloads" Default="" Mode="rw" Description="Host path to your DOWNLOADS folder (e.g., /mnt/user/data/downloads or /mnt/user/Downloads)" Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Config Storage" Target="/config" Default="/mnt/user/appdata/f1arr" Mode="rw" Description="Persistent config storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/f1arr</Config>
  <Config Name="F1 Library Path" Target="F1_LIBRARY_PATH" Default="/media/F1" Mode="" Description="Path to F1 library INSIDE container (relative to Media Library mount, e.g., /media/Motorsport/F1)" Type="Variable" Display="always" Required="true" Mask="false">/media/F1</Config>
  <Config Name="F1 Downloads Path" Target="F1_DOWNLOADS_PATH" Default="/downloads/complete/f1" Mode="" Description="Path to completed F1 downloads INSIDE container" Type="Variable" Display="always" Required="true" Mask="false">/downloads/complete/f1</Config>
  <Config Name="Timezone" Target="TZ" Default="Europe/London" Mode="" Description="Container timezone" Type="Variable" Display="always" Required="true" Mask="false">Europe/London</Config>
  <Config Name="SABnzbd URL" Target="SABNZBD_URL" Default="" Mode="" Description="SABnzbd URL (e.g., http://192.168.1.100:8080)" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="SABnzbd API Key" Target="SABNZBD_API_KEY" Default="" Mode="" Description="SABnzbd API key" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Prowlarr URL" Target="PROWLARR_URL" Default="" Mode="" Description="Prowlarr URL (e.g., http://192.168.1.100:9696)" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Prowlarr API Key" Target="PROWLARR_API_KEY" Default="" Mode="" Description="Prowlarr API key" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Plex URL" Target="PLEX_URL" Default="" Mode="" Description="Plex URL (e.g., http://192.168.1.100:32400)" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Plex Token" Target="PLEX_TOKEN" Default="" Mode="" Description="Plex authentication token" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="PYTHONUNBUFFERED" Target="PYTHONUNBUFFERED" Default="1" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
</Container>
